# =======================================================
# Archivo de Configuración de Entorno (.env)
# =======================================================

# -------------------------------------------------------
# Configuración de OpenAI (GPT)
# Reemplaza con tu clave real, o deja vacío si solo usas Gemini.
# -------------------------------------------------------
OPENAI_API_KEY=sk-TU_CLAVE_DE_OPENAI_AQUI
LLM_MODEL=gpt-3.5-turbo

# -------------------------------------------------------
# Configuración de Google Gemini
# Reemplaza con tu clave real de Gemini.
# -------------------------------------------------------
GEMINI_API_KEY=AIzaSyCuR8PSFWjD-XlqB2c0P3DYGRhgD7thetM
GEMINI_MODEL=gemini-2.0-flash-lite

# -------------------------------------------------------
# Configuración General
# Establece el proveedor por defecto.
# -------------------------------------------------------
DEFAULT_LLM=gemini 

# Ruta a la base de datos (generalmente no se cambia)
VECTOR_DB_PATH=base_vectorial 

# Modelo de embeddings usado para FAISS
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2